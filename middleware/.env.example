PORT=3200
NODE_ENV=development

# JWT da Identity API (mesmo usado nas configurações do coliseu_transporte e autocenter)
JWT_DEVICE_KEY=coloque_sua_chave_jwt_aqui

# Worker
EXPECTED_MODULE_SLUG=coliseu-transporte
INTERNAL_API_KEY=sua_internal_api_key

# PostgreSQL
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=coliseu_dashboard
PG_USER=postgres
PG_PASSWORD=minha_senha
PG_SSL=false

# Rate Limit
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=500
